# Required — at least one provider key
# GEMINI_API_KEY=AIza...
# OPENAI_API_KEY=sk-proj-...
# ANTHROPIC_API_KEY=sk-ant-...

# Optional — defaults shown
# SELKEY_PORT=3100
# SELKEY_MODEL_ID=claude-sonnet-4-6
# SELKEY_SIGNING_KEY_HEX=          # 64-char hex; omit for ephemeral key
# SELKEY_SESSION_TTL_SECS=600

# Local development — required when running from repo root
SELKEY_PROMPT_PROGRAM_DIR=packages/selkey-relay/prompt_programs
SELKEY_SCHEMA_DIR=schemas/output
SELKEY_ENV=dev
SELKEY_INBOX_AUTH=off
