# Required — at least one provider key
# GEMINI_API_KEY=AIza...
# OPENAI_API_KEY=sk-proj-...
# ANTHROPIC_API_KEY=sk-ant-...

# Optional — defaults shown
# SELKEY_PORT=3100
# SELKEY_MODEL_ID=claude-sonnet-4-6
# SELKEY_SIGNING_KEY_HEX=          # 64-char hex (openssl rand -hex 32); required unless SELKEY_ENV=dev
# SELKEY_SESSION_TTL_SECS=600
# SELKEY_OPERATOR_TOKEN=           # shared by the relay and the demo agents (openssl rand -hex 32)
# SELKEY_RELAY_VERIFYING_KEY_HEX=  # relay key for agents; the local demo pins its relay's key automatically

# Local development — required when running from repo root
SELKEY_PROMPT_PROGRAM_DIR=packages/selkey-relay/prompt_programs
SELKEY_SCHEMA_DIR=schemas/output
SELKEY_ENV=dev
SELKEY_INBOX_AUTH=off
