{
  "name": "selkey",
  "version": "0.1.0",
  "description": "Standalone HTTP client for the Selkey relay",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./types": {
      "import": "./dist/types.js",
      "types": "./dist/types.d.ts"
    },
    "./contracts": {
      "import": "./dist/relay-contracts.js",
      "types": "./dist/relay-contracts.d.ts"
    },
    "./http": {
      "import": "./dist/http.js",
      "types": "./dist/http.d.ts"
    },
    "./inbox": {
      "import": "./dist/inbox.js",
      "types": "./dist/inbox.d.ts"
    },
    "./verify": {
      "import": "./dist/verify-receipt.js",
      "types": "./dist/verify-receipt.d.ts"
    },
    "./tee": {
      "import": "./dist/tee-verify.js",
      "types": "./dist/tee-verify.d.ts"
    },
    "./contract-builder": {
      "import": "./dist/contract-builder.js",
      "types": "./dist/contract-builder.d.ts"
    },
    "./receipt-v3": {
      "import": "./dist/receipt-v3.js",
      "types": "./dist/receipt-v3.d.ts"
    },
    "./commitment": {
      "import": "./dist/commitment-v3.js",
      "types": "./dist/commitment-v3.d.ts"
    },
    "./contract-hash": {
      "import": "./dist/contract-hash-v2.js",
      "types": "./dist/contract-hash-v2.d.ts"
    },
    "./jcs": {
      "import": "./dist/jcs-v3.js",
      "types": "./dist/jcs-v3.d.ts"
    },
    "./ed25519": {
      "import": "./dist/ed25519-strict.js",
      "types": "./dist/ed25519-strict.d.ts"
    }
  },
  "bin": {
    "selkey-contract": "./dist/cli.js"
  },
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/vcav-io/selkey"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write 'src/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts'",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "canonicalize": "5.1.0",
    "json-canonicalize": "^2.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@types/node": "^20.0.0",
    "eslint": "^9.19.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.5.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.22.0",
    "vitest": "^1.6.1"
  }
}
