{
  "description": "Golden vectors for transcript v3 (av-tee-transcript-v3) and the relay configuration hash (av-tee-relay-config-v1). Encoding: LP(version) || LP(name) || LP(value) for each field in order, LP(x) = big-endian u64 byte length || UTF-8 bytes. Booleans encode as \"true\"/\"false\". Relay config hash = hex(SHA-256(encoding)); transcript hash = hex(SHA-512(encoding)).",
  "transcript_version": "av-tee-transcript-v3",
  "relay_config_version": "av-tee-relay-config-v1",
  "relay_config_field_order": [
    "provider_id",
    "provider_base_url",
    "model_id_requested",
    "policy_lockfile_hash",
    "model_profile_allowlist_hash",
    "relay_git_rev",
    "echo_mode",
    "simulated",
    "env"
  ],
  "transcript_field_order": [
    "contract_hash",
    "prompt_template_hash",
    "initiator_submission_hash",
    "responder_submission_hash",
    "output_hash",
    "receipt_signing_pubkey_hex",
    "model_identity_asserted",
    "relay_config_hash"
  ],
