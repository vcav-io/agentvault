# Stage 1: Build all three TypeScript packages
FROM node:20-slim AS builder
WORKDIR /build

# Copy all source (file: deps require source present during npm install)
COPY packages/selkey-client packages/selkey-client
COPY packages/selkey-mcp packages/selkey-mcp
COPY packages/selkey-demo-ui packages/selkey-demo-ui
COPY demo/alice-prompt.md demo/alice-prompt.md
COPY demo/bob-prompt.md demo/bob-prompt.md

# Install and build in dependency order
RUN cd packages/selkey-client && npm install --ignore-scripts && npm run build
RUN cd packages/selkey-mcp && npm install --ignore-scripts && npm run build
RUN cd packages/selkey-demo-ui && npm install --ignore-scripts && npm run build

# Stage 2: Runtime
FROM node:20-slim
WORKDIR /app

# Copy built packages with node_modules
COPY --from=builder /build/packages/selkey-client packages/selkey-client
COPY --from=builder /build/packages/selkey-mcp packages/selkey-mcp
COPY --from=builder /build/packages/selkey-demo-ui packages/selkey-demo-ui
COPY --from=builder /build/demo/alice-prompt.md demo/alice-prompt.md
COPY --from=builder /build/demo/bob-prompt.md demo/bob-prompt.md
COPY packages/selkey-relay/prompt_programs packages/selkey-relay/prompt_programs

ENV DEMO_PORT=3200
EXPOSE 3200

HEALTHCHECK --interval=10s --timeout=3s --retries=3 \
    CMD node -e "fetch('http://localhost:3200/api/status').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"

CMD ["node", "packages/selkey-demo-ui/dist/server.js"]
